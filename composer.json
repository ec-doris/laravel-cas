{
    "name": "ec-doris/laravel-cas",
    "description": "A Laravel CAS authentication bundle for EU Login and EC applications with automatic configuration and route publishing.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "authentication",
        "cas",
        "central authentication service",
        "single sign-on",
        "sso",
        "laravel",
        "eu-login",
        "european-commission"
    ],
    "homepage": "https://github.com/ec-doris/laravel-cas",
    "support": {
        "issues": "https://github.com/ec-doris/laravel-cas/issues",
        "source": "https://github.com/ec-doris/laravel-cas"
    },
    "authors": [
        {
            "name": "EC DORIS Team",
            "homepage": "https://github.com/ec-doris"
        }
    ],
    "require": {
        "php": ">= 8.1",
        "ext-dom": "*",
        "ext-simplexml": "*",
        "ecphp/cas-lib": "^3.0",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^9 || ^10 || ^11 || ^12 || ^13.0",
        "loophp/psr17": "^1.0",
        "nyholm/psr7": "^1.8",
        "symfony/cache": "^6.4 || ^7.0 || ^8.0",
        "symfony/psr-http-message-bridge": "^6.4 || ^7.1 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.26 || ^9.4 || ^10.0 || ^11.0@dev",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "EcDoris\\LaravelCas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/",
            "App\\Models\\Factories\\": "tests/Factories/",
            "EcDoris\\LaravelCas\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "laravel": {
            "providers": [
                "EcDoris\\LaravelCas\\Providers\\AppServiceProvider"
            ]
        }
    },
    "scripts": {
        "phpunit": "vendor/bin/phpunit",
        "test": "vendor/bin/phpunit",
        "verify": [
            "Composer\\Config::disableProcessTimeout",
            "bash ./scripts/verify.sh"
        ],
        "e2e": [
            "Composer\\Config::disableProcessTimeout",
            "npm run e2e"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    }
}
